# ---------------------------------------------------------------------------
# Line endings.
#
# Declared before anything else so the binary overrides below win: in
# .gitattributes the last matching pattern for an attribute takes effect.
# ---------------------------------------------------------------------------
* text=auto eol=lf
*.php text eol=lf

# ---------------------------------------------------------------------------
# Binary files.
#
# `text=auto` guesses from content and guesses wrong: a PDF without NUL bytes
# in its first 8000 bytes is classified as text, and CRLF pairs inside its
# streams are then silently stripped on commit. docs/referenzen/rfc4791.pdf is
# already treated as text by that heuristic and survives only because it uses
# LF-only line endings. Marking these types binary removes the guess.
# ---------------------------------------------------------------------------
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.gz    binary

# ---------------------------------------------------------------------------
# Keep the distributed package small: only the runtime library, its licence
# and the metadata a consumer needs are shipped. Everything else is
# development scaffolding or documentation that lives on the repository page.
#
# The RFC references alone are roughly 1 MB, which every `composer require`
# would otherwise download.
# ---------------------------------------------------------------------------
/.github                export-ignore
/assets                 export-ignore
/bin                    export-ignore
/docs                   export-ignore
/examples               export-ignore
/tests                  export-ignore

/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore

/CHANGELOG.md           export-ignore
/CODE_OF_CONDUCT.md     export-ignore
/CONTRIBUTING.md        export-ignore
/GOVERNANCE.md          export-ignore
/SECURITY.md            export-ignore

# ---------------------------------------------------------------------------
# Language statistics: documentation and vendored references are not code.
# ---------------------------------------------------------------------------
/docs                   linguist-documentation
/assets                 linguist-documentation
/examples               linguist-documentation

{
    // Infection resolves "logs", "tmpDir" and the PHPUnit config directory
    // relative to THIS file, but hands "source.directories" straight to
    // Symfony Finder, which resolves against the working directory. The
    // ../../ prefixes below therefore point at the repository root, while
    // "src" stays root-relative because every entry point runs from there.
    "$schema": "../../vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "../../build/test/log/infection.log",
        "html": "../../build/test/log/infection.html",
        "summary": "../../build/test/log/infection-summary.log",
        "github": true
    },
    "tmpDir": "../../build/test/infection",
    "minMsi": 85,
    "minCoveredMsi": 90,
    // **This is not about slow mutants. It is about mutants being run at
    // all.** Infection skips a mutant outright when the *nominal* time of the
    // tests covering its line reaches this value:
    //
    //     if ($mutant->getMutation()->getNominalTestExecutionTime() < $this->timeout)
    //
    // That nominal time is the sum of the covering tests' durations as the
    // **initial** run measured them — and that run is the one with Xdebug
    // coverage switched on, where a test that takes a millisecond on its own
    // is measured at two hundred. A class whose tests all reach one method
    // therefore passes the default of ten seconds at about fifty tests, and
    // every mutant on that line is then counted as "skipped" rather than run.
    //
    // It is silent: the console says how many mutants were generated and how
    // many killed, and the difference only shows in
    // `build/test/log/infection-summary.log` on the `Skipped:` line. P4-07
    // generated 261 mutants and skipped 259 of them, for an MSI of 100 % over
    // two. **Read that line before believing a figure.**
    //
    // A mutant process runs only the tests that cover it, and without
    // coverage, so a sound one finishes in well under a second. Two minutes is
    // the cost of noticing a mutant that loops for ever, which is what the
    // timeout is really for.
    //
    // **Since P4-10 the nominal times are honest, and that is why this value
    // can stay where it is.** `composer mutation` hands Infection the coverage
    // from the sharded run and the timings from a run **without** coverage
    // (see bin/mutation-inputs.php), so the sum no longer carries Xdebug's
    // inflation. Measured on 07.10.2026 over the six recurrence classes: left
    // to measure for itself, Infection skipped 269 of 604 mutants and reported
    // an MSI over the 312 that ran; given honest timings, it skipped none and
    // killed 584.
    "timeout": 120,
    "testFramework": "phpunit",
    "mutators": {
        "@default": true,
        // Protocol constants come from the RFCs. Mutating them produces
        // noise, not insight.
        "ArrayItemRemoval": {
            "ignoreSourceCodeByRegex": ["\\$supportedReports\\s*=.*"]
        },
        // The file is written beside its place and moved in, so that a write
        // cut in half leaves the properties as they were rather than half of
        // them. Both mutants of that name end with the same file on disc: one
        // writes straight to it, the other writes to a relative name and moves
        // it in all the same. Nothing a test can observe tells them apart, and
        // dropping a durability measure to make a number go up would be
        // trading the data for the number.
        "ConcatOperandRemoval": {
            "ignore": [
                "DavServices\\Backend\\File\\PropertyStorage::write",
                // The same construction for the same reason, one layer along:
                // a card is written beside its place and moved in, so that a
                // write cut in half leaves the old card rather than half of
                // the new one. Every mutant of that temporary name ends with
                // the same file on disc — a unique name, moved onto the card —
                // and nothing a test can observe tells them apart. The one
                // that drops the directory from the name differs only where
                // the move would stop being atomic, and buying a number by
                // giving up the durability measure would be trading the data
                // for the number.
                "DavServices\\Backend\\File\\CardBackend::put",
                // And a calendar object, written beside its place and moved
                // in for the same reason and by the same line. Measured
                // rather than assumed: the mutant that writes to a relative
                // name was applied by hand to both stores, and the whole
                // suite passed either way — on a successful write the move
                // takes the temporary name away, and on a failed one the
                // cleanup does.
                "DavServices\\Backend\\File\\CalendarBackend::put",
            ]
        },
        // The same line of the same method, reached by three more mutators.
        // How long the random part of a temporary name is, and in which order
        // its pieces are joined, are not promises a card store can be held to:
        // eight bytes against seven or nine is the same unique name.
        // `stream_get_contents()` answers `string|false`, and PHPStan will not
        // let the `false` through: both guards read a request body that may
        // have arrived as a stream, and the cast is what turns an unreadable
        // one into an empty string instead of a TypeError. **No honest input
        // tells the mutant from the original.** A readable stream answers `''`
        // rather than `false`, and an unreadable one raises a warning that the
        // suite turns into a failure either way — so the case the cast is for
        // is the one case a test cannot arrange.
        "CastString": {
            "ignore": [
                "DavServices\\Plugin\\CalDav::bytesIn",
                "DavServices\\Plugin\\CardDav::bytesIn",
            ]
        },
        "Concat": {
            "ignore": [
                "DavServices\\Backend\\File\\CardBackend::put",
                "DavServices\\Backend\\File\\CalendarBackend::put",
            ]
        },
        // **A time zone falls through the range either way, and the skip
        // says why it is skipped.** §9.6.5 has it that the components that
        // come back "MUST NOT […] include VTIMEZONE components", so
        // {@see \DavServices\CalDav\Expander} leaves one out where it meets
        // it — and §9.9 defines no table for that kind, so the range test
        // behind it would drop one too. Nothing a test can observe tells the
        // two apart, and relying on the second would make §9.6.5's rule an
        // accident of another section.
        "DecrementInteger": {
            "ignore": [
                "DavServices\\CalDav\\Expander::appliedTo",
                "DavServices\\Backend\\File\\CardBackend::put",
                "DavServices\\Backend\\File\\CalendarBackend::put",
                // **How many matches a report will answer is a server's own
                // number, and no test can watch the default one.** RFC 4791
                // §7.8 asks for "server-specific, predefined limits" and names
                // no value, so five thousand against four thousand nine
                // hundred and ninety-nine is the same promise. Telling them
                // apart would mean a calendar of five thousand objects in a
                // unit test; what the limit *does* is measured instead, with a
                // limit the case sets itself. The same is true of
                // `CardDav\Report\AddressBookMultiGet::__construct`, where the
                // pair is left to be judged by whoever next reads the log.
                "DavServices\\CalDav\\Report\\CalendarQuery::__construct",
            ]
        },
        // **A comparison against nothing, where nothing is already answered.**
        // {@see \DavServices\CalDav\TimeRange::moved()} returns itself for a
        // shift of zero seconds — an override's gap is nothing, and a range
        // moved by nothing is that range — so the sign test below it never
        // sees a zero, and `> 0` and `>= 0` cannot be told apart by any shift
        // that reaches it.
        "GreaterThan": {
            "ignore": [
                "DavServices\\CalDav\\TimeRange::moved",
            ]
        },
        "IncrementInteger": {
            "ignore": [
                "DavServices\\Backend\\File\\CardBackend::put",
                "DavServices\\Backend\\File\\CalendarBackend::put",
                // RFC 5051 step (2)(a) speaks of "the codepoints in the
                // titlecase property", plural, so the preparation loops over
                // whatever titlecasing handed back rather than assuming one
                // character. UnicodeData's titlecase field holds a single
                // codepoint in every case, and that is what makes the chunk
                // size of the inner split unobservable: one or two, the loop
                // sees the same single character. The loop stays because the
                // memo's wording does, and no input can tell the mutant from
                // the original.
                "DavServices\\Dav\\Collation\\UnicodeCasemap::prepare",
                // And the other half of the pair above: the default number of
                // matches a `calendar-query` will answer.
                "DavServices\\CalDav\\Report\\CalendarQuery::__construct",
            ]
        },
        // A variadic parameter is a list already, so dropping array_values()
        // there changes nothing a test could observe. The call is what lets
        // the static analyser see the list the constructor asks for. An
        // equivalent mutant that can never be killed does not measure the
        // tests — it only hides the next real gap behind a number that is
        // already below 100.
        "UnwrapArrayValues": {
            "ignore": [
                "DavServices\\Http\\Headers::with",
                // Same reason: the call is what makes the return the list its
                // type says it is, and dropping it changes nothing a test
                // could see.
                "DavServices\\Xml\\Writer::namespacesOf",
            ]
        }
    }
}
